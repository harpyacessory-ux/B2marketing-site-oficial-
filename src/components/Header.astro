---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/logo-b2.png'
import { nav, site } from '../data/site'
---

<header class="sticky top-0 z-40 border-b border-white/8 bg-navy-950/90 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href="#inicio" class="flex items-center gap-3" aria-label={`${site.name}, início`}>
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} class="size-11" />
      <span class="leading-none text-white">
        <span class="block text-lg font-bold [font-stretch:115%]">B2</span>
        <span class="block text-[0.68rem] font-semibold tracking-[0.18em] text-mist uppercase"
          >Marketing Industrial</span
        >
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[0.95rem] font-medium text-mist transition-colors hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="#contato"
        class="btn btn-primary hidden min-h-11 px-5 py-2.5 text-sm sm:inline-flex"
        data-cta="header-diagnostico"
      >
        Agendar diagnóstico
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg text-white hover:bg-white/10 lg:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    class="hidden border-t border-white/8 bg-navy-950 lg:hidden"
    aria-label="Menu"
    data-menu
  >
    <ul class="wrap flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-3 text-base font-medium text-white/90 hover:text-neon"
              data-menu-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 pb-3 sm:hidden">
        <a href="#contato" class="btn btn-primary w-full" data-cta="menu-diagnostico" data-menu-link>
          Agendar diagnóstico
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')

  function setOpen(open: boolean) {
    if (!toggle || !menu) return
    menu.classList.toggle('hidden', !open)
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
  }

  toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false))
  document.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })
</script>
