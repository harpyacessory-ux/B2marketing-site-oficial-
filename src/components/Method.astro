---
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'
import { method } from '../data/content'
---

<section id="metodo-b2" class="tech-bg py-20 text-white md:py-28">
  <div class="wrap">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeader dark eyebrow={method.eyebrow} title={method.title} lead={method.lead} />
      <a href="#contato" class="btn btn-primary shrink-0" data-cta="metodo-diagnostico">
        Começar diagnóstico
        <Icon name="arrow" class="size-4.5" strokeWidth={2.25} />
      </a>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        method.steps.map((step, i) => (
          <li class="rounded-2xl border border-white/10 bg-navy-900/70 p-7">
            <p class="text-sm font-bold tracking-widest text-neon">
              ETAPA {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
            <p class="mt-1 text-sm font-semibold text-white/70">{step.subtitle}</p>
            <p class="mt-4 leading-relaxed text-mist">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-20">
      <h3 class="text-2xl font-bold md:text-3xl">Como é um projeto na prática</h3>
      <ol class="relative mt-10 grid gap-8 md:grid-cols-3 md:gap-6">
        <span
          class="absolute top-[0.375rem] right-0 left-0 hidden h-px bg-gradient-to-r from-neon via-neon/60 to-neon/10 shadow-[0_0_8px_rgb(46_155_255/0.8)] md:block"
          aria-hidden="true"></span>
        {
          method.timeline.map((phase) => (
            <li class="relative border-l border-neon/40 pl-6 md:border-l-0 md:pl-0">
              <span class="absolute top-1 -left-[0.4rem] size-3 rounded-full bg-neon shadow-[0_0_12px_rgb(46_155_255)] md:relative md:top-0 md:left-0 md:block" />
              <p class="text-xs font-bold tracking-[0.16em] text-neon uppercase md:mt-6">
                {phase.when}
              </p>
              <p class="mt-2 text-lg font-bold">{phase.title}</p>
              <p class="mt-2 leading-relaxed text-mist">{phase.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
