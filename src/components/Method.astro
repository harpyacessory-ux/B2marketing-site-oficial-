---
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'
import { steps } from '../data/content'
---

<section id="metodo" class="tech-bg py-20 text-white md:py-28">
  <div class="wrap">
    <SectionHeader
      dark
      eyebrow="Como trabalhamos"
      title="Do diagnóstico à correção de rota semanal"
      lead="Um processo que começa no que o seu comercial precisa e não termina no lançamento da campanha."
    />

    <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => {
          const last = i === steps.length - 1
          return (
            <li
              class:list={[
                'relative rounded-2xl border p-7',
                last
                  ? 'border-neon/60 bg-navy-800/80 shadow-[0_0_50px_-18px_rgb(46_155_255/0.7)]'
                  : 'border-white/10 bg-navy-900/60',
              ]}
            >
              <div class="flex items-center justify-between">
                <span class="text-neon">
                  <Icon name={step.icon} class="size-7" />
                </span>
                <span class="text-sm font-bold tracking-widest text-mist">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-6 text-xl font-bold">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-mist">{step.text}</p>
              {last && (
                <p class="mt-5 inline-flex rounded-full border border-neon/40 px-3 py-1 text-xs font-semibold tracking-wide text-neon">
                  Toda segunda-feira
                </p>
              )}
            </li>
          )
        })
      }
    </ol>
  </div>
</section>
