---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import heroImage from '../assets/hero.jpg'
import { hero } from '../data/content'
import { whatsappLink } from '../data/site'
---

<section id="inicio" class="on-dark relative isolate overflow-hidden bg-navy-950 text-white">
  <Image
    src={heroImage}
    alt=""
    widths={[800, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[70%_center]"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/88 to-navy-950/45"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-navy-950 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="wrap pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-3xl">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="mt-6 text-[2.35rem] leading-[1.08] font-extrabold sm:text-5xl lg:text-[3.6rem]">
        Marketing digital com quem é <span class="neon-text">especialista</span> no mercado industrial
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">{hero.lead}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#contato" class="btn btn-primary" data-cta="hero-diagnostico">
          Agendar diagnóstico
          <Icon name="arrow" class="size-4.5" strokeWidth={2.25} />
        </a>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
          data-cta="hero-whatsapp"
        >
          <Icon name="message" class="size-4.5" strokeWidth={2} />
          Falar pelo WhatsApp
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:gap-6">
      <p class="shrink-0 font-semibold tracking-[0.14em] text-mist uppercase">Especialidades</p>
      <ul class="flex flex-wrap gap-2">
        {
          hero.specialties.map((item) => (
            <li>
              <a
                href="#servicos"
                class="inline-flex rounded-full border border-white/15 bg-navy-950/50 px-3.5 py-1.5 font-medium text-white/90 backdrop-blur transition-colors hover:border-neon hover:text-neon"
              >
                {item}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
