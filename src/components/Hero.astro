---
import Icon from './Icon.astro'
import { channels, heroPoints, journey } from '../data/content'
import { whatsappLink } from '../data/site'
---

<section id="inicio" class="tech-bg on-dark overflow-hidden text-white">
  <div
    class="wrap grid items-center gap-14 pt-16 pb-20 md:pt-24 lg:grid-cols-[1.15fr_0.85fr] lg:pb-28"
  >
    <div>
      <p class="eyebrow">Agência de marketing industrial</p>
      <h1 class="mt-6 text-[2.35rem] leading-[1.08] font-extrabold sm:text-5xl lg:text-[3.6rem]">
        Marketing que gera <span class="neon-text">oportunidades</span> para quem vende para a indústria
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist md:text-xl">
        Google Ads, LinkedIn, landing pages, marketplaces e conteúdo técnico trabalhando juntos para
        atrair compradores, engenheiros e decisores B2B, e entregar contatos qualificados ao seu time
        de vendas.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
          data-cta="hero-whatsapp"
        >
          Falar com um especialista
          <Icon name="arrow" class="size-4.5" strokeWidth={2.25} />
        </a>
        <a href="#servicos" class="btn btn-ghost" data-cta="hero-servicos">Ver serviços</a>
      </div>

      <ul class="mt-9 flex flex-col gap-x-6 gap-y-2.5 text-[0.95rem] text-white/85 sm:flex-row sm:flex-wrap">
        {
          heroPoints.map((point) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4.5 text-neon" strokeWidth={2.5} />
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="relative rounded-2xl border border-neon/25 bg-navy-900/70 p-6 shadow-[0_0_60px_-20px_rgb(46_155_255/0.55)] backdrop-blur sm:p-8"
    >
      <p class="text-xs font-semibold tracking-[0.16em] text-mist uppercase">
        Da busca ao seu comercial
      </p>
      <ol class="relative mt-6 space-y-6">
        <span
          class="absolute top-5 bottom-5 left-5 w-px bg-gradient-to-b from-neon via-neon/60 to-neon/10 shadow-[0_0_8px_rgb(46_155_255/0.8)]"
          aria-hidden="true"></span>
        {
          journey.map((step) => (
            <li class="relative flex gap-4">
              <span class="relative z-10 flex size-10 shrink-0 items-center justify-center rounded-lg border border-neon/40 bg-navy-950 text-neon">
                <Icon name={step.icon} class="size-5" />
              </span>
              <div class="pt-0.5">
                <p class="font-semibold text-white">{step.title}</p>
                <p class="mt-1 text-sm leading-snug text-mist">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="border-t border-white/8">
    <div
      class="wrap flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:gap-8"
    >
      <p class="shrink-0 font-semibold tracking-[0.14em] text-mist uppercase">Canais que operamos</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold text-white/80">
        {channels.map((channel) => <li>{channel}</li>)}
      </ul>
    </div>
  </div>
</section>
