---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/logo-b2.png'
import { services } from '../data/content'
import { nav, site, whatsappLink } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="bg-navy-950 text-mist">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr_1.2fr]">
    <div>
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={52} height={52} densities={[1, 2]} class="size-13" />
        <p class="text-lg leading-tight font-bold text-white">{site.name}</p>
      </div>
      <p class="mt-5 max-w-xs leading-relaxed">{site.tagline}.</p>
      <p class="mt-5 flex gap-2 text-sm leading-relaxed">
        <Icon name="pin" class="mt-0.5 size-4.5 shrink-0 text-neon" />
        <span>{site.address.street}<br />{site.address.city} - {site.address.state}</span>
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram da B2 Marketing Industrial"
          class="flex size-10 items-center justify-center rounded-lg border border-white/12 text-white/80 hover:border-neon hover:text-neon"
        >
          <Icon name="instagram" class="size-5" />
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn da B2 Marketing Industrial"
          class="flex size-10 items-center justify-center rounded-lg border border-white/12 text-white/80 hover:border-neon hover:text-neon"
        >
          <Icon name="linkedin" class="size-5" />
        </a>
      </div>
    </div>

    <nav aria-label="Rodapé">
      <p class="text-sm font-semibold tracking-[0.14em] text-white uppercase">Navegação</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href="#inicio" class="hover:text-white">Início</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="#contato" class="hover:text-white">Contato</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold tracking-[0.14em] text-white uppercase">Soluções</p>
      <ul class="mt-4 space-y-2.5">
        {
          services.map((service) => (
            <li>
              <a href="#servicos" class="hover:text-white">
                {service.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-[0.14em] text-white uppercase">Contato</p>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-white"
            >WhatsApp {site.whatsapp.display}</a
          >
        </li>
        <li>
          <a href={`tel:${site.phone.tel}`} class="hover:text-white">Fixo {site.phone.display}</a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="hover:text-white"
            set:html={site.email.replace('@', '@<wbr>')}
          />
        </li>
      </ul>
      <a href="#contato" class="btn btn-primary mt-6 min-h-11 px-5 py-2.5 text-sm">
        Agendar diagnóstico
      </a>
    </div>
  </div>

  <div class="border-t border-white/8">
    <p class="wrap py-6 text-sm">
      {`© ${year} ${site.legalName} · CNPJ ${site.cnpj} · Todos os direitos reservados.`}
    </p>
  </div>
</footer>
