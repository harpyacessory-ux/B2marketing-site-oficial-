---
import Icon from './Icon.astro'
import SectionHeader from './SectionHeader.astro'
import { challenges } from '../data/content'
---

<section class="py-20 md:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <SectionHeader
      eyebrow="O desafio"
      title="Venda industrial não se resolve com marketing genérico"
      lead="Produto técnico, ticket alto e decisão compartilhada pedem uma estratégia que fale a língua de quem especifica, compra e aprova."
    />

    <ul class="divide-y divide-line border-y border-line">
      {
        challenges.map((item) => (
          <li class="flex gap-5 py-7">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand/8 text-brand">
              <Icon name={item.icon} />
            </span>
            <div>
              <h3 class="text-xl font-bold">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
